# Settings for install-ms-cp.sh. Every manifest in this directory is rendered
# with envsubst using these values.
#
#   ./install-ms-cp.sh ms-cp.env

# --- cluster ------------------------------------------------------------------
# kubectl context of the cluster that hosts the Workload Onboarding Plane
export CLUSTER_KUBECONTEXT="ms-dev"

# --- VM onboarding endpoint ---------------------------------------------------
# Hostname of the vmgateway. It must match the URL the VMs pass to Hydra:
#   hydra -e dev service token https://vmgateway.istio-system.rcb.use.k8s.az-dev.ms.com
export VM_ENDPOINT="vmgateway.istio-system.rcb.use.k8s.az-dev.ms.com"

# --- Hydra as the trusted JWT issuer ------------------------------------------
# The 'iss' claim of the tokens. Must match exactly, including the scheme.
export HYDRA_ISSUER="https://hydra-test.ms.com"
export HYDRA_SHORT_NAME="hydra"
# JWKS document of the Hydra issuer, used to verify the token signatures.
# Taken from the discovery document of the issuer (note: no ".json" suffix):
#   curl -s https://hydra-test.ms.com/.well-known/openid-configuration | jq .jwks_uri
#   -> "https://hydra-test.ms.com/.well-known/jwks"
export HYDRA_JWKS_URI="https://hydra-test.ms.com/.well-known/jwks"

# --- the workload ---------------------------------------------------------------
export APP_NAMESPACE="payments"
export APP_NAME="payments"
export WORKLOAD_GROUP_NAME="payments-v1"

# Subjects allowed to onboard: the 'sub' claim of the Hydra tokens. One per VM
# identity, space separated.
export ALLOWED_SUBJECTS="spiffe://hydra-test.ms.com/ms/user/nizam"
