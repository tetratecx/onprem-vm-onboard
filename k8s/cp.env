# Settings for install-cp.sh. Every manifest in this directory is rendered with
# envsubst using these values.
#
#   cp cp.env cp.env.local && vi cp.env.local
#   ./install-cp.sh cp.env.local --dry-run
#   ./install-cp.sh cp.env.local

# --- cluster ------------------------------------------------------------------
# kubectl context of the cluster that hosts the Workload Onboarding Plane.
export CLUSTER_KUBECONTEXT="mp-ms-demo"

# --- VM onboarding endpoint ---------------------------------------------------
# Hostname of the vmgateway. The VMs download the onboarding packages from it
# and onboard through it, so it must resolve and be reachable from every VM.
export VM_ENDPOINT="vms.tsb-ms-demo.aws-ce.sandbox.tetrate.io"

# Serving certificate for that hostname (01-cert.yaml).
# Set INSTALL_CERT="false" if the "vm-onboarding" secret in istio-system is
# created some other way.
export INSTALL_CERT="true"
# cert-manager issuer to sign it with. With the self-signed sandbox issuer the
# VMs must keep ONBOARDING_TLS_INSECURE="true"; point this at the corporate CA
# to drop that.
export CERT_ISSUER_NAME="selfsigned-ca"
export CERT_ISSUER_KIND="ClusterIssuer"

# --- Keycloak as the trusted JWT issuer ---------------------------------------
# The realm URL. This is exactly the 'iss' claim of the tokens Keycloak mints -
# no trailing slash, scheme included.
export KEYCLOAK_REALM_URL="https://keycloak.apigw.aws-ce.sandbox.tetrate.io/realms/tetrate"
# Short name the onboarding plane uses for this issuer. It becomes part of the
# WorkloadEntry name: <group>-jwt-<shortName>--<sub>
export KEYCLOAK_SHORT_NAME="keycloak"

# --- the workload -------------------------------------------------------------
export APP_NAMESPACE="payments"
export APP_NAME="payments"
export WORKLOAD_GROUP_NAME="payments-v1"

# --- who may onboard (04-onboarding-policy.yaml) ------------------------------
# The 'sub' claim of the tokens, space separated. For a Keycloak
# client_credentials token this is the UUID of the client's service account, not
# the client name. Read it off a real token:
#
#   cd ../vm && ./get-token.sh --decode | grep '"sub"'
#
# or from the admin API:
#   kubectl -n keycloak exec deploy/keycloak -- /opt/keycloak/bin/kcadm.sh \
#     get users -r tetrate -q username=service-account-vm-write --fields id
export ALLOWED_SUBJECTS="6a0fa1d1-0235-4d15-98a1-ada0bfe9f71e 4c028ee8-c4f9-46b7-afb6-ebea64743719"

# Additional claims the token must carry, as name=value pairs separated by
# spaces. They are matched against the 'custom_attributes' object of the token,
# which keycloak/add-client.sh populates. Leave empty to match on the subject
# alone. Repeat a name to allow several values:
#   "region=uscentral1 region=useast1 datacenter=datacenter1"
export ALLOWED_ATTRIBUTES="region=uscentral1 datacenter=datacenter1"
