# AWS-specific settings. Shared settings live in ../../common.tfvars.
#
#   cp aws.tfvars.example aws.tfvars
#   ../../deploy.sh apply aws

region         = "us-east-1"
instance_count = 2
instance_type  = "t3.medium"
os             = "rhel9"
# --- placement ---------------------------------------------------------------
# By default all of these instances take the placement from private_instances in
# ../../common.tfvars: all public, or all private behind the NAT gateway.
#
# To mix both in this one cloud, set the two counts instead. instance_count and
# private_instances are then ignored here. For two private and one public:
#
# private_instance_count = 2
# public_instance_count  = 1

# root_volume_size = 30
# vpc_cidr         = "10.42.0.0/16"
# availability_zones = ["us-east-1a", "us-east-1b"]

# A custom or hardened image instead of the stock RHEL one:
# ami_id = "ami-0123456789abcdef0"
