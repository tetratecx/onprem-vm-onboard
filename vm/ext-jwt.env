# The same configuration the rendered agent.config.yaml gives the plugin, in a
# form that can be sourced into a shell to run the plugin's own diagnostics by
# hand on the VM.
#
#   set -a; . ./ext-jwt.env; set +a
#
#   # full report: token request, iss, signature, aud
#   onboarding-agent-ext-jwt-credential-plugin check --audience https://vms.tsb-ms-demo.aws-ce.sandbox.tetrate.io
#
#   # the token the agent would receive, with the decoded claims
#   onboarding-agent-ext-jwt-credential-plugin token --audience https://vms.tsb-ms-demo.aws-ce.sandbox.tetrate.io --output json
#
#   # the ControlPlane issuer stanza, rendered from the live realm
#   onboarding-agent-ext-jwt-credential-plugin issuer-config \
#     --short-name keycloak --attributes-path .custom_attributes
#
# Reading EXT_JWT_CLIENT_SECRET_FILE needs root or the onboarding-agent user:
#   sudo -u onboarding-agent env $(grep -v '^#' ext-jwt.env | xargs) \
#     onboarding-agent-ext-jwt-credential-plugin check --audience <plane-uid>
#
# ./get-token.sh --check does all of this for you, reading vm.env instead.
EXT_JWT_ISSUER=https://keycloak.apigw.aws-ce.sandbox.tetrate.io/realms/tetrate
EXT_JWT_TOKEN_ENDPOINT=https://keycloak.apigw.aws-ce.sandbox.tetrate.io/realms/tetrate/protocol/openid-connect/token
EXT_JWT_JWKS_URI=https://keycloak.apigw.aws-ce.sandbox.tetrate.io/realms/tetrate/protocol/openid-connect/certs
EXT_JWT_GRANT_TYPE=client_credentials
#EXT_JWT_CLIENT_ID=vm-write
EXT_JWT_CLIENT_ID=vm-readonly
EXT_JWT_CLIENT_AUTH_METHOD=client_secret_post
EXT_JWT_CLIENT_SECRET_FILE=/etc/onboarding-agent/client-secret
EXT_JWT_AUDIENCE_MODE=param
EXT_JWT_VERIFY_TOKEN=true
EXT_JWT_REQUIRE_AUDIENCE=true
EXT_JWT_LOG_LEVEL=info
