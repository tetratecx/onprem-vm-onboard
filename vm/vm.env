# Settings for install-vm.sh. Copy it to keep local edits out of git:
#
#   cp vm.env vm.env.local && vi vm.env.local
#   sudo ./install-vm.sh vm.env.local

# --- Workload Onboarding Plane -----------------------------------------------
# Hostname of the vmgateway. The onboarding packages are downloaded from it and
# the agent onboards through it, so it must resolve and be reachable on 443:
#   getent hosts <this value> && curl -ksI https://<this value>/install/
VM_ENDPOINT="vms.tsb-ms-demo.aws-ce.sandbox.tetrate.io"

# "true" while the vmgateway certificate comes from an issuer this VM does not
# trust (k8s/01-cert.yaml uses a self-signed one). Set to "false" once that
# certificate is issued by the corporate CA.
ONBOARDING_TLS_INSECURE="true"

# UID of the Workload Onboarding Plane. It must appear in the 'aud' claim of the
# Keycloak token, or the plane rejects it. It is set from VM_ENDPOINT in
# k8s/02-control-plane-patch.yaml; read the live value with:
#   kubectl -n istio-system get cm onboarding-plane-config \
#     -o jsonpath='{.data.config\.yaml}' | grep uid
ONBOARDING_PLANE_UID="https://${VM_ENDPOINT}"

# --- WorkloadGroup this VM joins ---------------------------------------------
# Must already exist in the cluster (k8s/03-workload-group.yaml).
WORKLOAD_GROUP_NAMESPACE="payments"
WORKLOAD_GROUP_NAME="payments-v1"
# Which of this host's addresses goes into the WorkloadEntry, i.e. what the
# cluster will try to route to:
#
#   auto      ask the HostInfo plugin - an instance with a public address gets
#             INTERNET, one without gets VPC. The right default when the same
#             env file is used for instances in both subnets.
#   INTERNET  the cluster reaches this VM over its public address
#   VPC       over the private network
CONNECTED_OVER="auto"

# --- how the agent learns this host's addresses ------------------------------
#   plugin   (default) bin/hostinfo-plugin.sh, which reads the AWS, GCP or Azure
#            metadata service and reports the private address as VPC and the
#            public one as INTERNET. Required for CONNECTED_OVER=INTERNET to
#            work: a cloud public address is NAT'd to the instance and never
#            appears on a local interface.
#   basic    the agent's built-in interface scan - private addresses only
#   default  no hostinfo stanza at all; the agent decides for itself
HOSTINFO_MODE="plugin"
HOSTINFO_SOURCE="bin/hostinfo-plugin.sh"

# --- Keycloak (External JWT Credential Plugin) -------------------------------
# The realm URL: this is exactly the 'iss' claim of the tokens, and the token and
# JWKS endpoints are derived from it. No trailing slash.
KEYCLOAK_REALM_URL="https://keycloak.apigw.aws-ce.sandbox.tetrate.io/realms/tetrate"
# The Keycloak client this VM authenticates as, with the client_credentials
# grant. Created by k8s/keycloak/add-client.sh.
KEYCLOAK_CLIENT_ID="vm-write"
# The client secret. Prefer passing it in the environment so it is never written
# to a file in git:
#   sudo KEYCLOAK_CLIENT_SECRET='...' ./install-vm.sh vm.env.local
#   KEYCLOAK_CLIENT_SECRET='...' ./push-to-vm.sh ec2-user@<vm-ip>
#KEYCLOAK_CLIENT_SECRET="password"
KEYCLOAK_CLIENT_SECRET="password"

# Optional: CA bundle for the TLS connection to Keycloak. Leave empty when the
# Keycloak certificate is publicly trusted. With a corporate CA, point this at a
# PEM bundle on the VM, e.g. /etc/pki/ca-trust/source/anchors/corporate-ca.crt
KEYCLOAK_CA_FILE=""

# --- Plugin binary ------------------------------------------------------------
# Relative paths are resolved next to this script, so a binary in bin/ is carried
# to the VM by push-to-vm.sh. Must match the VM's architecture.
PLUGIN_SOURCE="bin/onboarding-agent-ext-jwt-credential-plugin"

# --- obs-tester demo app (optional) ------------------------------------------
# "true" installs a demo service on 127.0.0.1:8000 so the onboarded VM actually
# serves traffic. Set to "false" when the real application already runs here.
INSTALL_OBSTESTER="true"
# Where to find the ots binary. A relative path is resolved next to this script;
# /opt/ots-linux-x86_64 and ~/ots-linux-x86_64 are tried as well.
OBSTESTER_SOURCE="bin/ots-linux-x86_64"
OBSTESTER_SVCNAME="payments"
# Names pointed at the sidecar's egress address (127.0.0.2) through /etc/hosts,
# so the demo's outbound calls are captured by the mesh.
OBSTESTER_HOSTS="zipkin.istio-system accounting.payments"
