# Settings for install-ms-vm.sh (the MS VM, where Hydra issues the token).
#
#   sudo ./install-ms-vm.sh              # uses this file
#   sudo ./install-ms-vm.sh my.env       # or your own copy

# --- Workload Onboarding Plane -----------------------------------------------
# vmgateway hostname: onboarding packages and the onboarding connection.
VM_ENDPOINT="vmgateway.istio-system.rcb.use.k8s.az-dev.ms.com"
ONBOARDING_TLS_INSECURE="true"

# The audience Hydra mints the token for, which must equal the UID of the
# Workload Onboarding Plane. In the Hydra command it is the URL argument:
#   hydra -e dev service token https://vmgateway.istio-system.../
ONBOARDING_PLANE_UID="https://vmgateway.istio-system.rcb.use.k8s.az-dev.ms.com"

# --- WorkloadGroup this VM joins ---------------------------------------------
WORKLOAD_GROUP_NAMESPACE="payments"
WORKLOAD_GROUP_NAME="payments-v1"
CONNECTED_OVER="INTERNET"

# --- Hydra --------------------------------------------------------------------
# The 'iss' claim of the Hydra token. The ControlPlane must trust this issuer.
HYDRA_ISSUER="https://hydra-test.ms.com"
# The command the shim runs to obtain a token. {audience} is replaced with the
# audience the Onboarding Agent asks for (ONBOARDING_PLANE_UID above).
# It runs through 'bash -lc', so 'module load' works.
HYDRA_COMMAND="module load cloud/hydra/dev >/dev/null 2>&1; hydra -e dev service token {audience}"
# Run the shim as this user. Hydra usually needs a real user's environment and
# credentials, so this is normally NOT root.
HYDRA_USER="nizam"
HYDRA_TIMEOUT="60"

# JWKS document of the Hydra issuer. When set, the plugin verifies the signature
# of the token before handing it to the agent; clear it if the VM cannot reach
# this URL (the Workload Onboarding Plane verifies the signature in any case).
# From the discovery document of the issuer (note: no ".json" suffix):
#   curl -s https://hydra-test.ms.com/.well-known/openid-configuration | jq .jwks_uri
HYDRA_JWKS_URI="https://hydra-test.ms.com/.well-known/jwks"

# --- Local shim ----------------------------------------------------------------
SHIM_LISTEN_ADDRESS="127.0.0.1"
SHIM_LISTEN_PORT="9099"
# A random secret is generated at install time; the plugin sends it and the shim
# checks it, so other local users cannot mint tokens through the shim.
SHIM_SECRET_FILE="/etc/onboarding-agent/shim-secret"

# --- Plugin binary ------------------------------------------------------------
# Built with 'make build-linux-amd64' in ext-jwt-plugin and copied to bin/ here.
PLUGIN_SOURCE="bin/onboarding-agent-ext-jwt-credential-plugin"
