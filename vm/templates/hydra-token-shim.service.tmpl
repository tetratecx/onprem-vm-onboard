[Unit]
Description=Hydra token shim (OAuth 2.0 token endpoint in front of the Hydra CLI)
Documentation=file:///opt/hydra-token-shim/README.md
After=network-online.target
Wants=network-online.target
# the Onboarding Agent calls this shim on every credential request
Before=onboarding-agent.service

[Service]
Type=simple
# Hydra needs a real user's environment and credentials
User=${HYDRA_USER}
Environment=SHIM_LISTEN_ADDRESS=${SHIM_LISTEN_ADDRESS}
Environment=SHIM_LISTEN_PORT=${SHIM_LISTEN_PORT}
Environment=SHIM_SECRET_FILE=${SHIM_SECRET_FILE}
Environment=HYDRA_TIMEOUT=${HYDRA_TIMEOUT}
Environment=HYDRA_COMMAND=${HYDRA_COMMAND}
ExecStart=/usr/bin/python3 ${SHIM_PATH}
Restart=always
RestartSec=5s

# it only runs the hydra command and serves on the loopback interface
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
